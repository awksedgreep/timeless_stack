[Unit]
Description=Timeless Stack (Metrics, Logs, Traces, UI)
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10

ExecStartPre=-/usr/bin/podman rm -f timeless-stack
ExecStartPre=/usr/bin/podman pull ghcr.io/awksedgreep/timeless-stack:latest

ExecStart=/usr/bin/podman run --rm --name timeless-stack \
  -p 8428:8428 \
  -p 9428:9428 \
  -p 10428:10428 \
  -p 5556:5556 \
  -v timeless_data:/data \
  --env-file /etc/timeless-stack/env \
  --health-cmd "curl -fsS http://localhost:8428/live && curl -fsS http://localhost:9428/live && curl -fsS http://localhost:10428/live && curl -fsS http://localhost:5556 >/dev/null" \
  --health-interval 30s \
  --health-timeout 5s \
  --health-start-period 15s \
  --health-retries 3 \
  ghcr.io/awksedgreep/timeless-stack:latest

ExecStop=/usr/bin/podman stop timeless-stack

[Install]
WantedBy=multi-user.target

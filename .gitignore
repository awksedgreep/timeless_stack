# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# Local dev data (metrics/logs/traces storage)
/data/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
timeless_stack-*.tar

# Deploy secrets
deploy/env

# Iconify generates these component modules on demand; they have never been
# tracked and timeless_canvas handles an un-generated icon gracefully.
/lib/timeless_stack/iconify/

# Digested assets, produced by the assets.deploy alias at build time.
/priv/static/

# Test scratch stores (the /tmp/ rule above does not cover this path).
/test/tmp/

#!/bin/sh
# Timeless BEAM tuning — scales from embedded (1 core, 2GB) to server (192 cores, 1.5TB)
# These flags are evaluated at release boot time.

# Keep distribution closed by default. Operators and release drills may opt in
# explicitly so `rpc`, `stop`, and `restart` remain usable without editing the
# generated artifact.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# ---------------------------------------------------------------------------
# Detect system resources
# ---------------------------------------------------------------------------
case "$(uname -s)" in
  Darwin)
    CORES=$(sysctl -n hw.ncpu)
    RAM_MB=$(( $(sysctl -n hw.memsize) / 1024 / 1024 ))
    ;;
  *)
    CORES=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
    RAM_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
    ;;
esac

# Allow overrides via environment
CORES="${TIMELESS_CORES:-$CORES}"
RAM_MB="${TIMELESS_RAM_MB:-$RAM_MB}"

# ---------------------------------------------------------------------------
# Scheduler tuning
# ---------------------------------------------------------------------------
# +swt very_low  — wake idle schedulers aggressively (TSDB ingestion is bursty)
# +scl false     — disable compaction (we want all cores active, not power-saving)
SCHED_FLAGS="+swt very_low +scl false"

# +sbt ps — bind schedulers to physical processors to prevent cache-line bouncing.
# Only on Linux with >1 core. macOS doesn't support scheduler binding.
# Skip on single-core to avoid unnecessary overhead.
if [ "$CORES" -gt 1 ] && [ "$(uname -s)" != "Darwin" ]; then
  SCHED_FLAGS="$SCHED_FLAGS +sbt ps"
fi

# +SDcpu N — dirty CPU schedulers, 1:1 with cores.
# Gorilla encode/decode, Zstd, and OpenZL all run on dirty CPU schedulers.
SCHED_FLAGS="$SCHED_FLAGS +SDcpu $CORES"

# ---------------------------------------------------------------------------
# Async I/O threads
# ---------------------------------------------------------------------------
# SQLite (exqlite) does file I/O via driver threads. More threads prevent
# disk ops from stalling normal schedulers.
# Scale: 2x cores, floor 4, ceiling 128.
ASYNC=$(( CORES * 2 ))
[ "$ASYNC" -lt 4 ] && ASYNC=4
[ "$ASYNC" -gt 128 ] && ASYNC=128

# ---------------------------------------------------------------------------
# Memory: heap sizes
# ---------------------------------------------------------------------------
# +hms   — minimum heap size (words). Larger = fewer GCs, more RAM per process.
# +hmbs  — minimum binary virtual heap size. Forces GC to reclaim ref-counted
#           binaries sooner, preventing "ghost memory" from compressed blocks.
#
# Tiny machines get defaults. Larger machines trade RAM for CPU.
if [ "$RAM_MB" -gt 8192 ]; then
  HEAP_FLAGS="+hms 1024 +hmbs 1024"
elif [ "$RAM_MB" -gt 2048 ]; then
  HEAP_FLAGS="+hms 512 +hmbs 512"
else
  HEAP_FLAGS=""
fi

# ---------------------------------------------------------------------------
# Memory: allocator tuning (machines with substantial RAM)
# ---------------------------------------------------------------------------
# +MBas aobf  — Address Order Best Fit for binary allocator
# +MEas aobf  — Address Order Best Fit for ETS allocator
# Packs data into lowest addresses so higher carriers can be freed to OS.
# +MBlmbcs / +MElmbcs — larger multi-block carriers reduce mmap/munmap churn.
ALLOC_FLAGS=""
if [ "$RAM_MB" -gt 32768 ]; then
  ALLOC_FLAGS="+MBas aobf +MEas aobf"

  if [ "$RAM_MB" -gt 131072 ]; then
    # 128GB+: 512MB carriers
    ALLOC_FLAGS="$ALLOC_FLAGS +MBlmbcs 512 +MElmbcs 512"
  else
    # 32-128GB: 256MB carriers
    ALLOC_FLAGS="$ALLOC_FLAGS +MBlmbcs 256 +MElmbcs 256"
  fi
fi

# ---------------------------------------------------------------------------
# Memory: super carrier (very large machines only)
# ---------------------------------------------------------------------------
# Pre-allocates a contiguous virtual address block, bypassing OS mmap
# fragmentation. Critical at 192 cores where kernel VM lock contention
# causes latency spikes during allocation.
# Only enable above 256GB — on smaller machines it wastes address space.
SC_FLAGS=""
if [ "$RAM_MB" -gt 262144 ]; then
  SC_SIZE=$(( RAM_MB * 60 / 100 ))
  SC_FLAGS="+MMscs $SC_SIZE"
fi

# ---------------------------------------------------------------------------
# Process / port limits (high core count only)
# ---------------------------------------------------------------------------
LIMIT_FLAGS=""
if [ "$CORES" -gt 64 ]; then
  LIMIT_FLAGS="+P 5000000 +Q 1048576"
elif [ "$CORES" -gt 16 ]; then
  LIMIT_FLAGS="+P 2000000 +Q 524288"
fi

# ---------------------------------------------------------------------------
# Assemble
# ---------------------------------------------------------------------------
export ERL_FLAGS="$SCHED_FLAGS +A $ASYNC $HEAP_FLAGS $ALLOC_FLAGS $SC_FLAGS $LIMIT_FLAGS"
